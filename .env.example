# Copy to .env and fill in. .env must be gitignored.
OPENROUTER_API_KEY=sk-or-v1-...

# Council member model. Confirm the current slug at https://openrouter.ai/deepseek
#   deepseek/deepseek-v4-flash-0731  cheap, fast, good for high-volume review
#   deepseek/deepseek-v4-pro         stronger reasoning, better for the debate round
ORX_MODEL=deepseek/deepseek-v4-flash-0731
ORX_EFFORT=high

# Claude Code models used by scripts/run_overnight.sh
LEAD_MODEL=opus
IMPL_MODEL=sonnet
# FINAL_MODEL=fable      # set to the Fable alias your /model menu shows
PERM_MODE=auto
MAX_BUILD_PASSES=12
